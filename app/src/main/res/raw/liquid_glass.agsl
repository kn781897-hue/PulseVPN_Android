uniform float2 iResolution;
uniform float iTime;
uniform shader iImage;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution.xy;

    // Параметры "жидкости"
    float speed = iTime * 1.5;
    float scale = 8.0;
    float strength = 0.005;

    // Искажение (волны)
    float distortion = sin(uv.x * scale + speed) * strength;
    distortion += cos(uv.y * scale * 0.8 + speed) * strength;

    float2 distortedUV = uv + float2(distortion, distortion);

    // Получаем цвет из оригинального изображения по искаженным координатам
    return iImage.eval(distortedUV * iResolution.xy);
}
