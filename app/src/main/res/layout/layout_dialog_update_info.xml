<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_glass"
    android:padding="24dp">

    <!-- Header Icon -->
    <FrameLayout
        android:id="@+id/flUpdateIconContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/bg_glass_circle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivUpdateDialogIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_rocket"
            app:tint="#00E5FF"
            android:contentDescription="update icon" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvUpdateDialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Доступно обновление"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/flUpdateIconContainer" />

    <!-- Version Pills Container -->
    <LinearLayout
        android:id="@+id/llVersionPills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUpdateDialogTitle">

        <!-- New Version Pill -->
        <TextView
            android:id="@+id/tvNewVersionPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_active_pill"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            tools:text="v1.5"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Current Version Text -->
        <TextView
            android:id="@+id/tvCurrentVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            tools:text="Текущая: v1.4"
            android:textColor="#8E8EA0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Changelog Container Card -->
    <LinearLayout
        android:id="@+id/llChangelogCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_stat_card"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llVersionPills">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Что нового:"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxHeight="130dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tvChangelogContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#D1D1DB"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                tools:text="• Улучшена стабильность соединения\n• Оптимизация интерфейса\n• Исправление мелких ошибок" />
        </ScrollView>
    </LinearLayout>

    <!-- Primary Update Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnDoUpdate"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_dialog_button_primary"
        android:text="ОБНОВИТЬ СЕЙЧАС"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llChangelogCard" />

    <!-- Secondary "Later" Button -->
    <TextView
        android:id="@+id/btnUpdateLater"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Напомнить позже"
        android:textColor="#8E8EA0"
        android:textSize="13sp"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnDoUpdate" />

</androidx.constraintlayout.widget.ConstraintLayout>

